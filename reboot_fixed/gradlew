#!/bin/sh
# REBOOT Gradle 8.9 launcher. Kept self-contained so the project can be built
# with ./gradlew even when the standard wrapper JAR is not present in the source archive.
set -eu
APP_HOME=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
GRADLE_VERSION=8.9
DIST_NAME="gradle-${GRADLE_VERSION}-bin.zip"
DIST_URL="https://services.gradle.org/distributions/${DIST_NAME}"
GRADLE_USER_HOME="${GRADLE_USER_HOME:-${HOME}/.gradle}"
DIST_DIR="${GRADLE_USER_HOME}/wrapper/dists/${DIST_NAME%.zip}"
GRADLE_BIN="${DIST_DIR}/gradle-${GRADLE_VERSION}/bin/gradle"
if [ ! -x "$GRADLE_BIN" ]; then
  mkdir -p "$DIST_DIR"
  ZIP="$DIST_DIR/$DIST_NAME"
  if [ ! -f "$ZIP" ]; then
    if command -v curl >/dev/null 2>&1; then
      curl -fL --retry 3 --connect-timeout 15 -o "$ZIP" "$DIST_URL"
    elif command -v wget >/dev/null 2>&1; then
      wget -O "$ZIP" "$DIST_URL"
    else
      echo "ERROR: curl or wget is required to download Gradle 8.9." >&2
      exit 1
    fi
  fi
  rm -rf "$DIST_DIR/gradle-${GRADLE_VERSION}"
  if command -v unzip >/dev/null 2>&1; then
    unzip -q "$ZIP" -d "$DIST_DIR"
  else
    echo "ERROR: unzip is required to install Gradle 8.9." >&2
    exit 1
  fi
fi
exec "$GRADLE_BIN" "$@"
